<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.tasktopia.controller.LoginController"
        style="-fx-background-color: linear-gradient(to bottom right, #1e2a4a, #2e3f6e, #4a6cf7);"
        prefWidth="1100" prefHeight="700">

    <VBox alignment="CENTER" spacing="0" maxWidth="380">

        <!-- Logo -->
        <VBox alignment="CENTER" spacing="4">

            <!-- Correct TextFlow logo -->
            <TextFlow textAlignment="CENTER">
                <Text text="Task"
                      style="-fx-font-size: 36px; -fx-font-weight: bold;
                             -fx-font-family: 'Segoe UI'; -fx-fill: white;"/>
                <Text text="Topia"
                      style="-fx-font-size: 36px; -fx-font-weight: bold;
                             -fx-font-family: 'Segoe UI'; -fx-fill: #ffd93d;"/>
            </TextFlow>

            <Text text="YOUR TASKS, ORGANISED"
                  style="-fx-font-size: 10px; -fx-font-family: 'Segoe UI';
                         -fx-fill: rgba(255,255,255,0.5);
                         -fx-letter-spacing: 2px;"/>
        </VBox>

        <!-- Card -->
        <VBox alignment="CENTER" spacing="14"
              style="-fx-background-color: rgba(255,255,255,0.07);
                     -fx-background-radius: 28;
                     -fx-border-color: rgba(255,255,255,0.15);
                     -fx-border-radius: 28; -fx-border-width: 1;
                     -fx-padding: 48 44 44 44;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 50, 0, 0, 12);">

            <TextField fx:id="usernameField"
                       promptText="Username"
                       style="-fx-background-color: rgba(255,255,255,0.10);
                              -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 12;
                              -fx-background-radius: 12; -fx-border-width: 1.5;
                              -fx-padding: 12 16; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                              -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.45);"
                       prefWidth="292"/>

            <PasswordField fx:id="passwordField"
                           promptText="Password"
                           style="-fx-background-color: rgba(255,255,255,0.10);
                                  -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 12;
                                  -fx-background-radius: 12; -fx-border-width: 1.5;
                                  -fx-padding: 12 16; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                                  -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.45);"
                           prefWidth="292"/>

            <Label fx:id="errorLabel" text=""
                   visible="false" wrapText="true"
                   style="-fx-text-fill: #ff6b6b; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;"/>

            <Button text="Sign in"
                    onAction="#handleLogin"
                    prefWidth="292"
                    style="-fx-background-color: linear-gradient(to right, #4a6cf7, #6b8fff);
                           -fx-text-fill: white; -fx-font-family: 'Segoe UI';
                           -fx-font-weight: bold; -fx-font-size: 14px;
                           -fx-padding: 14 0; -fx-background-radius: 12; -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(74,108,247,0.4), 16, 0, 0, 6);">
                <VBox.margin><Insets top="6"/></VBox.margin>
            </Button>

            <!-- Create account link -->
            <HBox alignment="CENTER" spacing="6">
                <VBox.margin><Insets top="10"/></VBox.margin>
                <Label text="Don't have an account?"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px;
                              -fx-text-fill: rgba(255,255,255,0.55);"/>
                <Hyperlink text="Create account" onAction="#goToSignup"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px;
                                  -fx-text-fill: #ffd93d; -fx-border-width: 0;
                                  -fx-underline: true; -fx-cursor: hand;
                                  -fx-padding: 0;"/>
            </HBox>

        </VBox>
    </VBox>
</StackPane>
