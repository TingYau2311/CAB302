<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.tasktopia.controller.HomeController"
        fx:id="rootStack"
        style="-fx-background-color: #f4f6fb;"
        prefWidth="1100" prefHeight="700">

    <!-- ROOT LAYOUT -->
    <VBox>

        <!-- ── TOP NAV BAR ── -->
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-background-color: #1e2a4a; -fx-padding: 12 20;">

            <!-- Logo -->
            <Label text="TaskTopia"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;
                          -fx-font-family: 'Segoe UI'; -fx-text-fill: white;" />

            <Region prefWidth="20"/>

            <!-- Categories -->
            <HBox fx:id="topbarNav" spacing="6">

                <Button fx:id="navAll" id="nav-all" text="🏠 All"
                        onAction="#onAllTasks"
                        style="-fx-background-color: #4a6cf7; -fx-text-fill: white;
                               -fx-background-radius: 10; -fx-padding: 8 14;" />

                <Button fx:id="navWork" id="nav-work" text="💼 Work"
                        onAction="#onWork"
                        style="-fx-background-color: transparent; -fx-text-fill: #a8b8d8;" />

                <Button fx:id="navGrocery" id="nav-grocery" text="🛒 Grocery"
                        onAction="#onGrocery"
                        style="-fx-background-color: transparent; -fx-text-fill: #a8b8d8;" />

                <Button fx:id="navPersonal" id="nav-personal" text="👤 Personal"
                        onAction="#onPersonal"
                        style="-fx-background-color: transparent; -fx-text-fill: #a8b8d8;" />

                <Button fx:id="navSchool" id="nav-school" text="📚 School"
                        onAction="#onSchool"
                        style="-fx-background-color: transparent; -fx-text-fill: #a8b8d8;" />

                <Button fx:id="navMedical" id="nav-medical" text="🏥 Medical"
                        onAction="#onMedical"
                        style="-fx-background-color: transparent; -fx-text-fill: #a8b8d8;" />

                <Button fx:id="navSocial" id="nav-social" text="🎉 Social"
                        onAction="#onSocial"
                        style="-fx-background-color: transparent; -fx-text-fill: #a8b8d8;" />

                <Button fx:id="navFitness" id="nav-fitness" text="🏋️ Fitness"
                        onAction="#onFitness"
                        style="-fx-background-color: transparent; -fx-text-fill: #a8b8d8;" />
            </HBox>

            <!-- Push right side -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Right-side buttons -->
            <Button text="＋ New Category"
                    onAction="#onNewCategory"
                    style="-fx-background-color: transparent;
                           -fx-border-color: rgba(255,255,255,0.25);
                           -fx-border-style: dashed;
                           -fx-border-radius: 10;
                           -fx-text-fill: rgba(255,255,255,0.6);
                           -fx-padding: 8 14;" />

            <Button text="⚙️ Settings"
                    onAction="#onSettings"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #a8b8d8;" />

            <Button text="🚪 Log Out"
                    onAction="#onLogout"
                    style="-fx-background-color: rgba(255,107,107,0.15);
                           -fx-text-fill: #ff6b6b;
                           -fx-background-radius: 10;" />
        </HBox>

        <!-- ── MAIN CONTENT (UNCHANGED) ── -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background: #f4f6fb; -fx-background-color: #f4f6fb;
                           -fx-border-color: transparent;">

            <VBox style="-fx-background-color: #f4f6fb; -fx-padding: 40 40 60 40;"
                  spacing="0">

                <HBox alignment="CENTER_LEFT">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label fx:id="pageTitle" text="Today's Tasks"
                               style="-fx-font-size: 26px; -fx-font-weight: bold;
                                      -fx-font-family: 'Segoe UI'; -fx-text-fill: #1e2a4a;"/>

                        <Label fx:id="pageSubtitle" text="All your tasks for today"
                               style="-fx-font-size: 12px; -fx-font-family: 'Segoe UI';
                                      -fx-text-fill: #8898aa;"/>
                    </VBox>

                    <Label fx:id="headerDate"
                           style="-fx-background-color: white; -fx-background-radius: 20;
                                  -fx-padding: 7 16; -fx-font-family: 'Segoe UI';
                                  -fx-font-size: 12px; -fx-text-fill: #8898aa;
                                  -fx-effect: dropshadow(gaussian, rgba(74,108,247,0.10), 10, 0, 0, 3);"/>
                    <HBox.margin><Insets bottom="28"/></HBox.margin>
                </HBox>

                <VBox fx:id="tasksList" spacing="14" style="-fx-padding: 28 0 0 0;"/>

                <HBox spacing="16" style="-fx-padding: 28 0 0 0;">
                    <Button text="✨  Add Smart Task"
                            onAction="#onAddAI"
                            style="-fx-background-color: linear-gradient(to right, #4a6cf7, #7b5cf7);
                                   -fx-text-fill: white; -fx-font-family: 'Segoe UI';
                                   -fx-font-weight: bold; -fx-font-size: 13px;
                                   -fx-padding: 13 22; -fx-background-radius: 12; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(74,108,247,0.35), 14, 0, 0, 5);"/>

                    <Button text="＋  Add Task Manually"
                            onAction="#onAddManual"
                            style="-fx-background-color: white; -fx-text-fill: #1e2a4a;
                                   -fx-font-family: 'Segoe UI'; -fx-font-weight: bold;
                                   -fx-font-size: 13px; -fx-padding: 13 22;
                                   -fx-background-radius: 12; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(74,108,247,0.10), 10, 0, 0, 3);"/>
                </HBox>
            </VBox>
        </ScrollPane>

    </VBox>
</StackPane>